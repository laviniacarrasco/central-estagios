# ============================================
# Credenciais e variáveis de ambiente
# ============================================
.env
.env.*
!.env.example

# ============================================
# Certificado CA local (usado só para resolver
# erro de SSL do cURL no Windows em ambiente local)
# ============================================
includes/cacert.pem

# ============================================
# Dependências (Composer)
# ============================================
/vendor/
composer.phar

# ============================================
# Uploads de usuários (opcional - avalie se
# quer versionar ou não os arquivos enviados
# pelos alunos, ex: PDFs de currículo, fotos)
# ============================================
/uploads/*
!/uploads/.gitkeep

# ============================================
# Dados da aplicacao (JSON) - TODOS VAO PARA O GIT
# --------------------------------------------
# Todos os data/*.json (inclusive bi/, mentoria, denuncias, relatorios, logs de
# acesso e o backup do TOTVS) vao para o git: o Render sobe com os mesmos dados
# do seu computador e o git vira mais uma copia de seguranca.
# Com o banco ligado, o espelho mantem esses JSON sempre em dia.
#
# FICA DE FORA so o controle interno do banco (data/_sistema/): lista de
# pendentes, conflitos e trava da sincronizacao. Se o pendentes.json do seu
# computador fosse para o Render, o servidor mandaria dados velhos para o banco.
# O repositorio PRECISA ser privado (os JSON tem CPF, e-mail e conversas).
# ============================================
/data/_sistema/
/data/**/*.tmp*

# ============================================
# Logs
# ============================================
*.log
error_log
/logs/

# ============================================
# Arquivos de IDE / Editor
# ============================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ============================================
# Sistema Operacional
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# Arquivos temporários de teste
# ============================================
teste-email.php
saida.html
node_modules/

# ============================================
# Integração TOTVS: cópia de segurança gerada a cada sincronização
# ============================================
/data/usuarios_backup_totvs.json
