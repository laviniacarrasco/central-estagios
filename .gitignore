# ============================================
# Credenciais e variáveis de ambiente
# ============================================
.env
.env.*
!.env.example

# ============================================
# Certificado CA local (usado só para resolver
# erro de SSL do cURL no Windows em ambiente local)
# ============================================
includes/cacert.pem

# ============================================
# Dependências (Composer)
# ============================================
/vendor/
composer.phar

# ============================================
# Uploads de usuários (opcional - avalie se
# quer versionar ou não os arquivos enviados
# pelos alunos, ex: PDFs de currículo, fotos)
# ============================================
/uploads/*
!/uploads/.gitkeep

# ============================================
# Dados da aplicacao (JSON) - TODOS VAO PARA O GIT (e para o Render)
# --------------------------------------------
# Os JSON sao a RESERVA de tudo:
#   - dos dados da Central, quando o banco de dados nao conecta
#     (o espelho mantem os JSON em dia enquanto o banco funciona);
#   - do TOTVS e do banco / data lake (data/reserva/), quando eles nao respondem.
# Por isso TODOS os data/**/*.json vao para o git: a cada deploy, o Render sobe
# com a reserva mais recente do seu computador.
#
# Fica de fora SO o controle interno do banco (data/_sistema/: pendentes,
# conflitos, trava). Ele vale so para a maquina onde foi gerado: se o
# pendentes.json do seu computador fosse para o Render, o servidor mandaria
# dados velhos para o banco por cima dos novos.
#
# O repositorio PRECISA ser privado (os JSON tem CPF, e-mail e conversas).
# ============================================
!/data/
!/data/**/
!/data/**/*.json
/data/_sistema/
/data/**/*.tmp*

# ============================================
# Logs
# ============================================
*.log
error_log
/logs/

# ============================================
# Arquivos de IDE / Editor
# ============================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ============================================
# Sistema Operacional
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# Arquivos temporários de teste
# ============================================
teste-email.php
saida.html
node_modules/

# ============================================
# v33: GARANTIA - todos os .json do projeto vao para o git
# (data/, data/users/<id>/, data/reserva/, composer.json etc.)
# Fica no FIM do arquivo para valer por cima das regras acima.
# Unica excecao: data/_sistema/ (controle interno do banco, ver acima).
# Para mandar ate ele, apague a linha "/data/_sistema/" abaixo.
# ============================================
!*.json
!**/*.json
/data/_sistema/
