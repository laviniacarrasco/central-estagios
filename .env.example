# Modelo do arquivo .env (copie para ".env" e preencha).
# O .env NUNCA vai para o git. No Render, cadastre as mesmas variáveis em Environment.

# ---------- Endereço do site ----------
APP_URL=http://localhost:8000

# ---------- E-mail (Gmail API) ----------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# ---------- Agendador (resumo semanal, vagas externas, TOTVS) ----------
ALERTAS_CRON_KEY=troque-por-uma-chave-longa-e-aleatoria

# ---------- Vagas externas ----------
# gupy (padrao, gratis, sem chave) | adzuna (pago) | gupy,adzuna | nenhuma
VAGAS_FONTE=gupy
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# ---------- TOTVS ----------
# Ainda sem acesso ao TOTVS: use "teste" (lê data/totvs_exemplo.json).
# Quando a TI liberar, troque para "real" e preencha o resto.
TOTVS_MODO=teste
TOTVS_URL=
TOTVS_USUARIO=
TOTVS_SENHA=
TOTVS_CODSENTENCA=
TOTVS_CODCOLIGADA=1
TOTVS_CODSISTEMA=S
# Modo "banco" (ler direto do banco do TOTVS, só leitura):
TOTVS_DB_DSN=
TOTVS_DB_USUARIO=
TOTVS_DB_SENHA=
# Tabela ou view com RA, NOME, CPF, EMAIL, CURSO, PERIODO, TURNO, SITUACAO
TOTVS_DB_TABELA=
# Ou um SELECT pronto (tem prioridade sobre a tabela)
TOTVS_DB_CONSULTA=

# ---------- Banco de dados da Central (todas as abas) ----------
# Veja docs/BANCO-DE-DADOS.md. Sem DADOS_DB_DSN, a Central usa só os JSON.
# auto/banco = banco primeiro, com os JSON de reserva se ele cair | json = só arquivos
DADOS_DRIVER=auto
DADOS_DB_DSN=
DADOS_DB_USUARIO=
DADOS_DB_SENHA=
DADOS_DB_TIMEOUT=3
DADOS_DB_TENTAR_DE_NOVO=30
DADOS_CRIAR_TABELAS=1
DADOS_ESPELHO_JSON=1
DADOS_MIGRAR_AUTO=1

# Nome da tabela de cada aba (opcional; o padrão está em includes/banco-tabelas.php)
# DADOS_TABELA_USUARIOS=central_usuarios
# DADOS_TABELA_PERFIS=central_perfis
# DADOS_TABELA_CURRICULOS=central_curriculos
# DADOS_TABELA_CERTIFICADOS=central_certificados
# DADOS_TABELA_PERFIL_COMPETENCIAS=central_perfil_competencias
# DADOS_TABELA_DICAS=central_dicas_progresso
# DADOS_TABELA_VAGAS=central_vagas
# DADOS_TABELA_VAGAS_SUGERIDAS=central_vagas_sugeridas
# DADOS_TABELA_SOLICITACOES_VAGA=central_solicitacoes_vaga
# DADOS_TABELA_VAGAS_EGRESSOS=central_vagas_egressos
# DADOS_TABELA_CANDIDATURAS=central_candidaturas
# DADOS_TABELA_FAVORITOS=central_favoritos
# DADOS_TABELA_POSTS=central_posts
# DADOS_TABELA_ASSINATURAS=central_assinaturas
# DADOS_TABELA_MENTORIA=central_mentoria
# DADOS_TABELA_DENUNCIAS=central_mentoria_denuncias
# DADOS_TABELA_EMPRESAS=central_empresas
# DADOS_TABELA_CURSOS=central_cursos
# DADOS_TABELA_ALERTAS=central_alertas
# DADOS_TABELA_PAINEIS=central_paineis
# DADOS_TABELA_LOG_ADMIN=central_log_admin
# DADOS_TABELA_LOG_ACESSOS=central_log_acessos
# DADOS_TABELA_TOTVS=central_totvs
# DADOS_TABELA_GERAL=central_dados

# ---------- Banco / data lake dos Painéis e Relatórios ----------
BI_SQL_DSN=
BI_SQL_USUARIO=
BI_SQL_SENHA=
